# Leave unset for same-origin dev/E2E via the Vite proxy (apiClient falls back to "/api").
# Set to the API origin for true cross-origin deployments, e.g. https://api.example.com
VITE_API_BASE_URL=

# Default admin-UI language for a first visit: a catalog code registered under src/locales.
# Leave unset for en. A language the user picked in the switcher always wins.
# Read at build time: a dev server reads frontend/.env; an image build reads a committed
# frontend/.env.production.
VITE_DEFAULT_UI_LOCALE=
