# Leave unset for same-origin dev/E2E via the Vite proxy (apiClient falls back to "/api").
# Set to the API origin for true cross-origin deployments, e.g. https://api.example.com
VITE_API_BASE_URL=

# Default admin-UI language for a first visit: any catalog registered in src/locales (en, zh-TW).
# Leave unset for en. A language the user picked in the switcher always wins. Read at build time.
VITE_DEFAULT_UI_LOCALE=
