# tests/ is deliberately NOT excluded: pnpm build runs `vue-tsc -b`, which
# follows tsconfig.json's project references including tsconfig.test.json,
# whose "include" is ["tests/**/*.ts", "src/**/*.d.ts"] -- without tests/ in
# the build context, that reference resolves to nothing and vue-tsc fails
# with TS18003 ("No inputs were found"). e2e/ below is safe to exclude only
# because no tsconfig in this project references it at all.
node_modules/
dist/
coverage/
test-results/
playwright-report/
blob-report/
e2e/
*.log
# Vite's local, gitignored env files are excluded here -- .env is a developer's
# own uncommitted file (Vite still loads it in production mode, so it would
# otherwise reach the build), and .env.local/.env.*.local are its per-mode
# equivalents. A committed frontend/.env.production (VITE_API_BASE_URL and
# friends, see frontend/.env.example) is NOT excluded and still reaches the
# image build.
.env
.env.local
.env.*.local
