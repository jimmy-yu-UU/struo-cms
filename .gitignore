bin/
obj/
*.user
appsettings.Development.json
.vs/
.idea/
node_modules/
dist/
# VitePress's transform cache for the docs site (docs/.vitepress/cache).
docs/.vitepress/cache/
logs/
*.log

# VitePress build artifacts. `dist/` above already covers docs/.vitepress/dist; the
# dependency cache needs its own entry.
docs/.vitepress/cache/

# Environment files - never commit real secrets
.env
.env.local
.env.*.local

# Runtime data written by the app: the local file-storage root
# (Struo:Files:Local:RootPath) and the image-transform cache
# (Struo:Files:ImageTransform:CachePath), both under App_Data by default.
App_Data/

# Test and build output
# Frontend-specific output (coverage, test-results, playwright-report) is owned
# by frontend/.gitignore so each file covers exactly its own scope.
TestResults/

# SonarScanner working directories: .sonarqube/ is written by
# `dotnet-sonarscanner begin` into the repository root, .scannerwork/ by the
# generic scanner into whichever directory it runs from. Both are regenerated by
# every analysis run; neither is ever committed.
.sonarqube/
.scannerwork/

# SQLite databases (used as the test backend)
*.db
*.db-shm
*.db-wal

# OS
.DS_Store
