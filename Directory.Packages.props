<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageVersion Include="FluentMigrator.Runner.Core" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.MySql" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.Oracle" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.SqlServer" Version="8.0.1" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.9" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.14" />
    <!--
      Pin transitive Microsoft.OpenApi to a patched version. Microsoft.AspNetCore.OpenApi 10.0.9
      pulls Microsoft.OpenApi 2.0.0, which has a known HIGH severity vulnerability
      (GHSA-v5pm-xwqc-g5wc). Fixed in 2.7.5+ (2.X branch) per the advisory. Requires a direct
      PackageReference in Struo.Api.csproj since CentralPackageTransitivePinningEnabled is not set.

      Stay on the 2.X branch. 3.x is not an option on .NET 10, and the reason is not this
      repository's code - nothing here touches the Microsoft.OpenApi API surface, only
      AddOpenApi()/MapOpenApi(). Microsoft.AspNetCore.OpenApi 10.0.10 declares a bare
      `>= 2.0.0` dependency with no upper bound, so NuGet will resolve 3.x, and its own
      XmlCommentGenerator then emits assignments to IOpenApiMediaType.Example, which 3.x made
      read-only: two CS0200 errors in a generated file, verified locally and in CI. Excluding the
      generator would trade the build error for a runtime one, because the shipped assembly is
      compiled against 2.x. Upstream's fix was to forbid 3.x, not to enable it - release/10.0 now
      constrains this to [2.7.5,3.0.0), which will first ship in 10.0.10's successor. 2.11.0 is the
      head of the 2.X branch. Revisit when this project moves to .NET 11, where
      Microsoft.AspNetCore.OpenApi 11.0.x ships against Microsoft.OpenApi 3.x.
      (dotnet/aspnetcore#64317, #67930; a matching Dependabot ignore rule holds the major back.)
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <PackageVersion Include="NetVips.Native" Version="8.18.7" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>