// Copy to appsettings.Development.json (gitignored) and edit.
// Every application-configuration key here can also be supplied as an environment variable
// using the double-underscore path separator, e.g. Database__ConnectionString. One exception:
// the four Testing:* keys below are read by the test suite through its own ConfigurationBuilder
// (no environment-variable provider registered), so Testing__PostgresConnection and the like have
// no effect — see the Testing comments for the env vars that actually work.
{
  "Database": {
    "DbType": "PostgreSQL",
    // Matches docker-compose.yml. Local development credentials only.
    "ConnectionString": "Host=localhost;Port=5432;Database=struo;Username=struo;Password=struo",
    // true = apply pending migrations when the host starts. false (the default) = the host refuses
    // to start until `dotnet run --project src/Struo.Api -- migrate` has run.
    "MigrateOnStartup": false
  },

  // Uncomment to enable the Blog sample (see docs/guide/en/23-sample-walkthrough.md).
  // The Struo.Sample.Blog project reference must be added to Struo.Api.csproj as well.
  "Struo": {
    // "ContentAssemblies": [ "Struo.Sample.Blog" ],
    "Files": {
      "Backend": "local",

      // To use the MinIO container from docker-compose.yml instead of local disk: change Backend
      // above to "s3", start it with
      // `docker compose --profile s3 up -d postgres redis minio createbuckets`, and uncomment
      // the S3 block below. Values match that file's dev credentials.
      // If you remapped the MinIO host port (STRUO_MINIO_PORT in .env), change Endpoint to match.
      // "S3": {
      //   "Endpoint": "http://localhost:9000",
      //   "Bucket": "struo-media",
      //   "AccessKey": "struoadmin",
      //   "SecretKey": "struoadmin",
      //   "Region": "us-east-1",
      //   "ForcePathStyle": true,
      //   "PresignTtlSeconds": 300
      // }
    }
  },

  // Redis-backed session ticket store. Empty = in-memory (sessions lost on restart).
  "Redis": {
    "ConnectionString": "localhost:6379"
  },

  "Testing": {
    // Opt-in live tests, one connection per backend: the migration tests, LiveRepositoryTests,
    // TestDatabaseLiveTests (PostgresOnlyTests on PostgreSQL only), and the API hosts and unit tests
    // when STRUO_TEST_BACKEND selects that backend. Point each at a DISPOSABLE database whose name
    // contains "test"; it must already exist, and the login needs create/drop-database rights (the
    // migration tests write into it directly; the other live suites create their own databases next
    // to it). An empty value makes the live tests return early as a pass, so judge them by per-test
    // duration; with STRUO_TEST_BACKEND set to that backend the run fails instead. The env vars
    // STRUO_TEST_PG_CONNECTION, STRUO_TEST_SQLSERVER_CONNECTION, STRUO_TEST_MYSQL_CONNECTION and
    // STRUO_TEST_MARIADB_CONNECTION override these keys — NOT Testing__PostgresConnection and the
    // like, which the double-underscore convention would otherwise suggest. MariaDB runs on the
    // MySql dialect and is reported as its own cases.
    "PostgresConnection": "",
    "SqlServerConnection": "",
    "MySqlConnection": "",
    "MariaDbConnection": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  }
}
