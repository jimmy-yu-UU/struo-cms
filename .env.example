# Copy to .env to override host ports when one is already in use on your machine.
# Container-side ports never change; only the host side is remapped.
# Compose reads .env automatically from this directory. .env is gitignored.
STRUO_PG_PORT=5432
STRUO_REDIS_PORT=6379

# Host ports of the admin SPA and the API, and the bootstrap admin the first start seeds.
# The default account is for local development only.
STRUO_ADMIN_PORT=8080
STRUO_API_PORT=8081
STRUO_ADMIN_EMAIL=admin@admin.com
STRUO_ADMIN_PASSWORD=admin

# MinIO only starts under the "s3" profile (docker compose --profile s3 up -d). If you change
# STRUO_MINIO_PORT, also update Struo:Files:S3:Endpoint in appsettings.Development.json.
STRUO_MINIO_PORT=9000
STRUO_MINIO_CONSOLE_PORT=9001
