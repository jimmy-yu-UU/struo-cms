# Copy to .env to override host ports when one is already in use on your machine.
# Container-side ports never change; only the host side is remapped.
# Compose reads .env automatically from this directory. .env is gitignored.
STRUO_PG_PORT=5432
STRUO_REDIS_PORT=6379

# Host address every published port binds to. 127.0.0.1 means only this machine reaches the
# services. 0.0.0.0 exposes them to the network, which publishes the fixed dev passwords and the
# password-less Redis to everyone on it.
STRUO_BIND_ADDRESS=127.0.0.1

# Host ports of the admin SPA and the API, and the bootstrap admin the first start seeds.
# STRUO_ADMIN_PASSWORD is required: set it before `docker compose up`, which fails while it is empty.
# Change STRUO_ADMIN_EMAIL from the default as well.
STRUO_ADMIN_PORT=8080
STRUO_API_PORT=8081
STRUO_ADMIN_EMAIL=admin@admin.com
STRUO_ADMIN_PASSWORD=

# MinIO only starts under the "s3" profile, for an API you run yourself with Struo:Files:Backend
# "s3" (docker compose --profile s3 up -d postgres redis minio createbuckets). If you change
# STRUO_MINIO_PORT, also update Struo:Files:S3:Endpoint in appsettings.Development.json.
STRUO_MINIO_PORT=9000
STRUO_MINIO_CONSOLE_PORT=9001
